<%- include('partials/header') %>
<h1>抽選一覧</h1>

<% if (msg) { %><p class="notice"><%= msg %></p><% } %>

<form method="get" action="/" class="filter">
  <label>キーワード
    <input type="text" name="keyword" value="<%= filter.keyword %>" placeholder="公演名・会場">
  </label>
  <label>状態
    <select name="status">
      <option value="">すべて</option>
      <option value="open" <%= filter.status === 'open' ? 'selected' : '' %>>受付中</option>
      <option value="drawn" <%= filter.status === 'drawn' ? 'selected' : '' %>>抽選済み</option>
    </select>
  </label>
  <button type="submit">絞り込む</button>
</form>

<table>
  <thead>
    <tr><th>公演名</th><th>会場</th><th>開催日</th><th>応募期間</th><th>当選枠</th><th>状態</th></tr>
  </thead>
  <tbody>
    <% if (events.length === 0) { %>
      <tr><td colspan="6" class="empty">該当するイベントはありません</td></tr>
    <% } %>
    <% events.forEach(function (e) { %>
      <tr>
        <td>
          <% if (currentUser.role === 'organizer') { %>
            <a href="/admin/events/<%= e.id %>"><%= e.name %></a>
          <% } else { %>
            <a href="/events/<%= e.id %>"><%= e.name %></a>
          <% } %>
        </td>
        <td><%= e.venue %></td>
        <td><%= moment(e.held_on).format('YYYY/MM/DD') %></td>
        <td class="period"><%= moment(e.entry_start).format('M/D') %> 〜 <%= moment(e.entry_end).format('M/D') %></td>
        <td class="num"><%= e.capacity.toLocaleString() %> 席</td>
        <td><span class="status status-<%= e.status %>"><%= e.status === 'open' ? '受付中' : '抽選済み' %></span></td>
      </tr>
    <% }); %>
  </tbody>
</table>
<%- include('partials/footer') %>
